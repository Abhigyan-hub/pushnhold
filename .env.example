PORT=4000
HOST=0.0.0.0
# Copy to backend/.env on EC2. Node listens privately; Nginx serves HTTPS.
DATABASE_URL=postgres://cascade:choose-a-strong-password@127.0.0.1:5432/cascade
DATABASE_SSL=false
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=https://cascade.mozartdev.in,http://localhost:5173,http://127.0.0.1:5173
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
AWS_REGION=eu-north-1
S3_BUCKET=cascade-event-images
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=CASCADE <beth.t@example.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
